# Copy to .env and adjust as needed. Defaults below match docker-compose.yml.

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marvelx

UPLOAD_DIR=./data/uploads
MAX_BATCH_FILE_SIZE_BYTES=26214400
MAX_CLAIMS_PER_BATCH=5000
MAX_REPORTED_ERRORS=200
LOG_LEVEL=INFO
